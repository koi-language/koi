# Koi API: the backend every model call can go through (chat, embeddings, image, video, audio).
# Any server that speaks the Koi API works: braxil.ai is the default, api.brabier.com serves the same API.
# KOI_API_URL=https://api.braxil.ai
# KOI_API_KEY=
# Image, video and audio are ONLY generated through the Koi API.
# Without KOI_API_KEY, chat and embeddings use the provider keys below directly.

# OpenAI API Key
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API Key (optional)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
