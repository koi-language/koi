legacy-peer-deps=true
# Refuse install with a Node major outside the `engines` window.
# Mirror of koi-cli/.npmrc — native modules (better-sqlite3, lancedb)
# embed `.node` binaries built against the runtime's ABI, and the
# packaged engine ships a Node-20 build via `pkg --target node20-*`.
# Without this flag npm prints a warning but continues, which is how
# we ended up with NODE_MODULE_VERSION 127 (Node 22) prebuilts being
# loaded by a Node 20 engine at runtime → MediaLibrary fails to attach,
# semantic index can't connect, gallery silently empties.
engine-strict=true
